# Copy to the ignored repository-root .env, replace every example value, and
# source it before running either E2E harness.
export E2E_HOMESERVER='https://matrix.example.org'
export E2E_ROOM_ID='!encrypted-room:matrix.example.org'
export UNENCRYPTED_E2E_ROOM_ID='!plaintext-room:matrix.example.org'
export E2E_BRIDGE_USER_ID='@bridge-test:matrix.example.org'
export E2E_SENDER_USER_ID='@sender-test:matrix.example.org'
# Preferred: supply designated test-device tokens and their original stores.
# Use a DIFFERENT profile/device set for each transport/response mode.
export E2E_AUTH_MODE='token'
export E2E_BRIDGE_ACCESS_TOKEN_FILE='/absolute/private/test-profile/bridge/access-token'
export E2E_BRIDGE_DEVICE_ID='TESTBRIDGEDEVICE'
export E2E_BRIDGE_STATE_DIR='/absolute/private/test-profile/bridge/state'
export E2E_SENDER_ACCESS_TOKEN_FILE='/absolute/private/test-profile/sender/access-token'
export E2E_SENDER_DEVICE_ID='TESTSENDERDEVICE'
export E2E_SENDER_STATE_DIR='/absolute/private/test-profile/sender/state'
# Encrypted suites additionally require this device on the bridge test account.
export E2E_HELPER_ACCESS_TOKEN_FILE='/absolute/private/test-profile/helper/access-token'
export E2E_HELPER_DEVICE_ID='TESTHELPERDEVICE'
export E2E_HELPER_STATE_DIR='/absolute/private/test-profile/helper/state'
# Encrypted stores must already be bootstrapped with matching device keys.
# Retrieve approved test tokens with nopass_pass.sh into 0600 files under 0700
# directories; do not paste secrets into this file or use production devices.
# Optional legacy mode: unset ALL token variables, then export
# E2E_AUTH_MODE=password and retrieve E2E_BRIDGE_PASSWORD/E2E_SENDER_PASSWORD
# through nopass_pass.sh. This creates owned disposable devices; no login retries.
export E2E_ACP_CWD='/tmp'
export E2E_ACP_COMMAND='["docker","--host","ssh://server.example.org","exec","-i","pi-acp","socat","UNIX-CONNECT:/run/pi-acp/acp.sock","STDIO"]'
