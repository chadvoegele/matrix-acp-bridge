# Copy to the ignored repository-root .env, replace every example value, and
# source it before running either E2E harness.
export E2E_HOMESERVER='https://matrix.example.org'
export E2E_ROOM_ID='!encrypted-room:matrix.example.org'
export UNENCRYPTED_E2E_ROOM_ID='!plaintext-room:matrix.example.org'
export E2E_BRIDGE_USER_ID='@bridge-test:matrix.example.org'
export E2E_SENDER_USER_ID='@sender-test:matrix.example.org'
# Default persistent test cache: one designated-password login per absent role.
# Retrieve passwords privately through nopass_pass.sh when sourcing your .env.
export E2E_AUTH_MODE='cache'
# Optional; default is $HOME/.local/state/matrix-acp-bridge/test-cache
# export E2E_CACHE_DIR='/absolute/private/test-cache'
export E2E_CACHE_PROFILE='default'
# export E2E_BRIDGE_PASSWORD="$(nopass_pass.sh designated-test-bridge)"
# export E2E_SENDER_PASSWORD="$(nopass_pass.sh designated-test-sender)"
# Room/thread and encrypted/plaintext profiles are automatically isolated.
# Existing profiles need no password and never log out during automatic cleanup.
# Explicit E2E_AUTH_MODE=token still supports supplied ACCESS_TOKEN_FILE,
# DEVICE_ID and STATE_DIR for each role (bridge/sender/encrypted helper).
# E2E_AUTH_MODE=password is reserved for disposable fresh-bootstrap tests.
export E2E_ACP_CWD='/tmp'
export E2E_ACP_COMMAND='["docker","--host","ssh://server.example.org","exec","-i","pi-acp","socat","UNIX-CONNECT:/run/pi-acp/acp.sock","STDIO"]'
